<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.footballai.datarefresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/franektrafas/Documents/Codex/2026-07-01/jeste-seniorem-machine-learning-engineer-data/.venv312/bin/python</string>
        <string>-m</string>
        <string>football_ai.scrapers.refresh_all</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/franektrafas/Documents/Codex/2026-07-01/jeste-seniorem-machine-learning-engineer-data</string>

    <!-- Once daily at 06:00 local time. To run more often during a live
         tournament, either add more <dict> entries to this array (one per
         time of day), or replace StartCalendarInterval with
         StartInterval (seconds) for a fixed-cadence schedule instead --
         no changes needed anywhere else. -->
