    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/franektrafas/Documents/Codex/2026-07-01/jeste-seniorem-machine-learning-engineer-data/football_ai/data/processed/refresh_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/franektrafas/Documents/Codex/2026-07-01/jeste-seniorem-machine-learning-engineer-data/football_ai/data/processed/refresh_stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
